{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "renewalradar",
  "version": "1.0.0",
  "description": "RenewalRadar reviews upcoming software, vendor, service, lease, and recurring-contract renewals to surface notice-window risk, under-use, overlap, price increases, and negotiation priorities.",
  "author": {
    "name": "QTMBG LLC",
    "url": "https://money-plugins-qtmbg.vercel.app"
  },
  "homepage": "https://money-plugins-qtmbg.vercel.app/renewalradar",
  "repository": "https://github.com/qtmbg/myguard",
  "keywords": [
    "renewal",
    "subscription",
    "contract",
    "spend",
    "renegotiation"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "RenewalRadar",
        "shortDescription": "See costly renewals before deadlines.",
        "longDescription": "RenewalRadar reviews upcoming software, vendor, service, lease, and recurring-contract renewals to surface notice-window risk, under-use, overlap, price increases, and negotiation priorities.",
        "developerName": "QTMBG LLC",
        "category": "Productivity",
        "capabilities": [
          "Assess renewal risk",
          "Find notice deadlines",
          "Identify under-used spend",
          "Prioritize renegotiation"
        ],
        "websiteURL": "https://money-plugins-qtmbg.vercel.app/renewalradar",
        "privacyPolicyURL": "https://money-plugins-qtmbg.vercel.app/privacy",
        "termsOfServiceURL": "https://money-plugins-qtmbg.vercel.app/terms",
        "defaultPrompt": [
          "What renews soon and what should we review?",
          "Should we renew this contract?",
          "Are we too late to cancel this auto-renewal?"
        ],
        "brandColor": "#111111",
        "composerIcon": "./assets/icon.svg",
        "logo": "./assets/icon.svg"
      }
    }
  }
}
